# =============================================================================
# CampusSafe — Environment Variable Template
# Copy to .env (never commit .env) and fill in your values.
# =============================================================================

# ── Supabase ──────────────────────────────────────────────────────────────────
# Your Supabase project URL (safe to expose to clients via --dart-define)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon (public) key — safe for Flutter/browser (enforced by RLS)
SUPABASE_ANON_KEY=your-anon-key-here

# ── Firebase ──────────────────────────────────────────────────────────────────
# Firebase project ID (used in the Edge Function FCM URL)
# Set this in the Supabase Edge Function secrets — NEVER in Flutter
FCM_PROJECT_ID=your-firebase-project-id

# FCM server key / OAuth2 access token for sending messages
# Set this in the Supabase Edge Function secrets — NEVER in Flutter
FCM_SERVER_KEY=your-fcm-server-key-or-oauth2-token

# ── Supabase Service Role (SERVER SIDE ONLY) ──────────────────────────────────
# Used ONLY in Supabase Edge Functions. NEVER put this in Flutter.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Dashboard (Next.js) ───────────────────────────────────────────────────────
# Same Supabase URL/anon key — paste in apps/dashboard/.env.local
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
